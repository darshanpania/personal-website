# PostHog (client-side, public — already in use)
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# AutoSend (server-side only — used by /api/subscribe and /api/send-newsletter)
AUTOSEND_API_KEY=
AUTOSEND_LIST_ID=

# Newsletter dispatch (server-side only — used by /api/send-newsletter)
# Bearer token the GitHub Action presents to authorize a campaign send.
SEND_NEWSLETTER_SECRET=
# Separate AutoSend list used when the route is called with dryRun=true.
AUTOSEND_DRY_RUN_LIST_ID=
