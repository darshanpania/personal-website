# PostHog (client-side, public — already in use)
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# AutoSend (server-side only — used by /api/subscribe and /api/confirm)
AUTOSEND_API_KEY=
# Confirmed subscribers. Campaigns target this list only.
AUTOSEND_LIST_ID=
# Double opt-in holding pen. Signups land here until they click the email link.
AUTOSEND_PENDING_LIST_ID=
# Signs the confirmation links. Any long random string; rotating it
# invalidates every unclicked link still in flight.
NEWSLETTER_CONFIRM_SECRET=
# Absolute origin used to build confirmation links. Defaults to the
# production site when unset.
SITE_URL=https://darshanpania.me

# Newsletter drafting (CI / scripts/newsletter-draft.mjs — new darshanpania.me project)
# AUTOSEND_SENDER_EMAIL and AUTOSEND_UNSUB_GROUP_ID are also read at runtime
# by /api/subscribe to send the confirmation email, so they need to exist in
# the Vercel environment too — not just in CI secrets.
AUTOSEND_SENDER_ID=
AUTOSEND_SENDER_EMAIL=musings@darshanpania.me
AUTOSEND_UNSUB_GROUP_ID=
NEWSLETTER_TEST_EMAIL=
