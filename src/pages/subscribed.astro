---
import Base from "@/layouts/Base.astro";

// Landing page for the confirmation link in the double opt-in email.
// /api/confirm redirects here with ?state=… once it has decided the outcome.
export const prerender = false;

type State = "confirmed" | "expired" | "invalid" | "error";

const raw = Astro.url.searchParams.get("state");
const state: State =
  raw === "confirmed" || raw === "expired" || raw === "invalid" || raw === "error"
    ? raw
    : "invalid";

const copy: Record<State, { heading: string; tagline: string; body: string }> = {
  confirmed: {
    heading: "confirmed",
    tagline: "you're on the list",
    body: "That's it — you'll get one email when a new post goes up, and nothing in between. No welcome sequence, no drip campaign, no re-engagement nudges. Just the writing.",
  },
  expired: {
    heading: "expired",
    tagline: "that link timed out",
    body: "Confirmation links are good for 48 hours, and this one is past it. Sign up again from any post and I'll send a fresh one straight away.",
  },
  invalid: {
    heading: "hmm",
    tagline: "that link didn't check out",
    body: "Either it got mangled in transit — some mail clients wrap long URLs — or it was never a real confirmation link. Try signing up again from any post and use the new email.",
  },
  error: {
    heading: "my fault",
    tagline: "something broke on my end",
    body: "Your link was fine; I couldn't finish the job. Give it a few minutes and click it again. If it keeps failing, email me and I'll add you by hand.",
  },
};

const { heading, tagline, body } = copy[state];
---

<Base title={`${tagline} — Darshan Pania`} description="Newsletter confirmation.">
  <section class="space-y-2">
    <h1
      class="font-mono text-2xl md:text-[2.25rem] font-medium text-(--text-primary) tracking-tight cursor-blink"
    >
      {heading}
    </h1>
    <p class="text-(--mono-accent) text-base font-mono">{tagline}</p>
  </section>

  <hr class="my-8 border-0 border-t border-(--border) w-10" />

  <p class="text-(--text-primary) text-base leading-7">{body}</p>

  <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm">
    <a href="/" class="text-(--mono-accent) hover:underline underline-offset-4">
      <span aria-hidden="true" class="icon-back">←</span> home
    </a>
    <a href="/blog" class="text-(--mono-accent) hover:underline underline-offset-4">
      writing <span aria-hidden="true" class="icon-fwd">→</span>
    </a>
  </div>
</Base>
