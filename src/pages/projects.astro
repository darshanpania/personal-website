---
import Base from "@/layouts/Base.astro";
import TypingName from "@/components/TypingName.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="projects — Darshan Pania" description="Side projects across mobile and web.">
  <TypingName
    text="projects"
    class="font-mono text-xl md:text-[1.5625rem] font-medium text-(--text-primary)"
  />

  <ul class="mt-10 border-t border-(--border)">
    {
      projects.map((p) => (
        <li class="border-b border-(--border) py-5 fade-in">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-(--text-primary) text-base font-medium">
              {p.data.name}
            </h2>
            <span class="font-mono text-xs text-(--text-secondary) shrink-0">
              {p.data.platform}
            </span>
          </div>
          <p class="mt-2 text-(--text-secondary) text-sm leading-6">
            {p.data.description}
          </p>
          <a
            href={p.data.link}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-block font-mono text-sm text-(--mono-accent) hover:underline underline-offset-4"
          >
            view <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
