---
import Base from "@/layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const wordsPerMinute = 220;
const wordCount = post.body?.split(/\s+/).length ?? 0;
const readMinutes = Math.max(1, Math.round(wordCount / wordsPerMinute));

const fmt = (d: Date) =>
  `${d.toLocaleString("en-US", { month: "short" })} ${d.getDate()}, ${d.getFullYear()}`;
---

<Base title={`${post.data.title} — Darshan Pania`} description={post.data.description}>
  <a
    href="/blog"
    class="font-mono text-sm text-(--mono-accent) hover:underline underline-offset-4"
  >
    <span aria-hidden>←</span> writing
  </a>

  <article class="mt-8">
    <h1 class="text-xl md:text-[1.5625rem] font-medium text-(--text-primary) leading-tight">
      {post.data.title}
    </h1>
    <p class="mt-3 font-mono text-sm text-(--text-secondary)">
      {fmt(post.data.date)} · {readMinutes} min read
    </p>

    <div class="prose-custom mt-10">
      <Content />
    </div>
  </article>
</Base>

<style is:global>
  .prose-custom {
    color: var(--text-primary);
    font-size: 1rem;
    line-height: 1.75;
  }
  .prose-custom p {
    margin: 1.25em 0;
    color: var(--text-primary);
  }
  .prose-custom h1,
  .prose-custom h2,
  .prose-custom h3 {
    margin-top: 2em;
    margin-bottom: 0.5em;
    color: var(--text-primary);
    font-weight: 600;
    line-height: 1.3;
  }
  .prose-custom h2 { font-size: 1.25rem; }
  .prose-custom h3 { font-size: 1.05rem; }
  .prose-custom a {
    color: var(--mono-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .prose-custom strong { color: var(--text-primary); font-weight: 600; }
  .prose-custom ul,
  .prose-custom ol {
    margin: 1em 0;
    padding-left: 1.4em;
  }
  .prose-custom ul { list-style: disc; }
  .prose-custom ol { list-style: decimal; }
  .prose-custom li { margin: 0.4em 0; }
  .prose-custom code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--surface);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }
  .prose-custom pre {
    font-family: var(--font-mono);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem;
    overflow-x: auto;
    margin: 1.5em 0;
    font-size: 0.875em;
  }
  .prose-custom pre code {
    background: transparent;
    padding: 0;
    border-radius: 0;
  }
  .prose-custom blockquote {
    border-left: 2px solid var(--border);
    padding-left: 1em;
    color: var(--text-secondary);
    font-style: italic;
  }
  .prose-custom hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2em 0;
  }
</style>
