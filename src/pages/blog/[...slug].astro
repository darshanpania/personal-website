---
import Base from "@/layouts/Base.astro";
import SocialIcon from "@/components/SocialIcon.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const wordsPerMinute = 220;
const wordCount = post.body?.split(/\s+/).length ?? 0;
const readMinutes = Math.max(1, Math.round(wordCount / wordsPerMinute));

const fmt = (d: Date) =>
  `${d.toLocaleString("en-US", { month: "short", timeZone: "UTC" })} ${d.getUTCDate()}, ${d.getUTCFullYear()}`;

const pageUrl = Astro.url.href;
const tweetUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(pageUrl)}`;
const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`;
---

<Base
  title={`${post.data.title} — Darshan Pania`}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.coverImage}
  publishedTime={post.data.date}
  jsonLd={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description ?? "",
    "datePublished": post.data.date.toISOString(),
    "author": {
      "@type": "Person",
      "name": "Darshan Pania",
      "url": "https://darshanpania.me",
    },
    "url": new URL(`/blog/${post.id}`, Astro.site ?? "https://darshanpania.me").href,
  })}
>
  <a
    href="/blog"
    class="font-mono text-sm text-(--mono-accent) hover:underline underline-offset-4"
  >
    <span aria-hidden="true">←</span> writing
  </a>

  <article class="mt-8">
    {post.data.coverImage && (
      <img
        src={post.data.coverImage}
        alt={post.data.title}
        class="w-full aspect-video rounded-lg object-cover mb-8"
      />
    )}
    <h1 class="text-xl md:text-[1.5625rem] font-medium text-(--text-primary) leading-tight">
      {post.data.title}
    </h1>
    <p class="mt-3 font-mono text-sm text-(--text-secondary)">
      {fmt(post.data.date)} · {readMinutes} min read
    </p>

    <div class="prose-custom mt-10">
      <Content />
    </div>

    <div class="mt-12 pt-8 border-t border-(--border) flex items-center gap-1">
      <span class="font-mono text-sm text-(--text-secondary) mr-2">share</span>

      <a
        href={tweetUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share on X (Twitter)"
        class="p-2 rounded-md text-(--mono-accent) hover:bg-(--surface) transition-colors"
      >
        <SocialIcon network="twitter" class="w-4 h-4" />
      </a>

      <a
        href={linkedInUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share on LinkedIn"
        class="p-2 rounded-md text-(--mono-accent) hover:bg-(--surface) transition-colors"
      >
        <SocialIcon network="linkedin" class="w-4 h-4" />
      </a>

      <button
        id="copy-url-btn"
        aria-label="Copy link"
        class="p-2 rounded-md text-(--mono-accent) hover:bg-(--surface) transition-colors"
      >
        <svg id="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <svg id="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4 hidden text-(--mono-accent)">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </button>
    </div>
  </article>
</Base>

<script>
  const btn = document.getElementById("copy-url-btn");
  const copyIcon = document.getElementById("copy-icon");
  const checkIcon = document.getElementById("check-icon");

  btn?.addEventListener("click", async () => {
    await navigator.clipboard.writeText(window.location.href);
    copyIcon?.classList.add("hidden");
    checkIcon?.classList.remove("hidden");
    setTimeout(() => {
      copyIcon?.classList.remove("hidden");
      checkIcon?.classList.add("hidden");
    }, 2000);
  });
</script>

<script
  is:inline
  define:vars={{
    slug: post.id,
    title: post.data.title,
    category: post.data.category,
  }}
>
  window.posthog?.capture?.("blog_post_view", { slug, title, category });
</script>

<style is:global>
  .prose-custom {
    color: var(--text-primary);
    font-size: 1rem;
    line-height: 1.75;
  }
  .prose-custom p {
    margin: 1.25em 0;
    color: var(--text-primary);
  }
  .prose-custom h1,
  .prose-custom h2,
  .prose-custom h3 {
    margin-top: 2em;
    margin-bottom: 0.5em;
    color: var(--text-primary);
    font-weight: 600;
    line-height: 1.3;
  }
  .prose-custom h2 { font-size: 1.25rem; }
  .prose-custom h3 { font-size: 1.05rem; }
  .prose-custom a {
    color: var(--mono-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .prose-custom strong { color: var(--text-primary); font-weight: 600; }
  .prose-custom ul,
  .prose-custom ol {
    margin: 1em 0;
    padding-left: 1.4em;
  }
  .prose-custom ul { list-style: disc; }
  .prose-custom ol { list-style: decimal; }
  .prose-custom li { margin: 0.4em 0; }
  .prose-custom code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--surface);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }
  .prose-custom pre {
    font-family: var(--font-mono);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem;
    overflow-x: auto;
    margin: 1.5em 0;
    font-size: 0.875em;
  }
  .prose-custom pre code {
    background: transparent;
    padding: 0;
    border-radius: 0;
  }
  .prose-custom blockquote {
    border-left: 2px solid var(--border);
    padding-left: 1em;
    color: var(--text-secondary);
    font-style: italic;
  }
  .prose-custom hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2em 0;
  }
  .prose-custom img {
    max-width: 100%;
    height: auto;
  }
</style>
