---
import Base from "@/layouts/Base.astro";
import SocialIcon from "@/components/SocialIcon.astro";
import NewsletterInline from "@/components/NewsletterInline.astro";
import NewsletterModal from "@/components/NewsletterModal.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Prev/next among local posts, newest first.
const allPosts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const newerPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const olderPost =
  currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

const wordsPerMinute = 220;
const wordCount = post.body?.split(/\s+/).length ?? 0;
const readMinutes = Math.max(1, Math.round(wordCount / wordsPerMinute));

const fmt = (d: Date) =>
  `${d.toLocaleString("en-US", { month: "short", timeZone: "UTC" })} ${d.getUTCDate()}, ${d.getUTCFullYear()}`;

const pageUrl = Astro.url.href;
const tweetUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(pageUrl)}`;
const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`;
---

<Base
  title={`${post.data.title} — Darshan Pania`}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.coverImage}
  publishedTime={post.data.date}
  jsonLd={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description ?? "",
    "datePublished": post.data.date.toISOString(),
    "author": {
      "@type": "Person",
      "name": "Darshan Pania",
      "url": "https://darshanpania.me",
    },
    "url": new URL(`/blog/${post.id}`, Astro.site ?? "https://darshanpania.me").href,
  })}
>
  <div id="reading-progress" aria-hidden="true"></div>

  <a
    href="/blog"
    class="font-mono text-sm text-(--mono-accent) hover:underline underline-offset-4"
  >
    <span aria-hidden="true" class="icon-back">←</span> writing
  </a>

  <article class="mt-8">
    {post.data.coverImage && (
      <img
        src={post.data.coverImage}
        alt={post.data.title}
        class="w-full aspect-video rounded-lg object-cover mb-8"
      />
    )}
    <h1 class="text-xl md:text-[1.5625rem] font-medium text-(--text-primary) leading-tight">
      {post.data.title}
    </h1>
    <p class="mt-3 font-mono text-sm text-(--text-secondary)">
      {fmt(post.data.date)} · {readMinutes} min read
    </p>

    <div class="prose-custom mt-10">
      <Content />
    </div>

    <div class="mt-12 pt-8 border-t border-(--border) flex items-center gap-1">
      <span class="font-mono text-sm text-(--text-secondary) mr-2">share</span>

      <a
        href={tweetUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share on X (Twitter)"
        class="p-2 rounded-md text-(--mono-accent) hover:bg-(--surface) transition-[background-color,transform] duration-150 hover:scale-110 active:scale-95 motion-reduce:transform-none"
      >
        <SocialIcon network="twitter" class="w-4 h-4" />
      </a>

      <a
        href={linkedInUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share on LinkedIn"
        class="p-2 rounded-md text-(--mono-accent) hover:bg-(--surface) transition-[background-color,transform] duration-150 hover:scale-110 active:scale-95 motion-reduce:transform-none"
      >
        <SocialIcon network="linkedin" class="w-4 h-4" />
      </a>

      <button
        id="copy-url-btn"
        aria-label="Copy link"
        class="p-2 rounded-md text-(--mono-accent) hover:bg-(--surface) transition-[background-color,transform] duration-150 hover:scale-110 active:scale-95 motion-reduce:transform-none"
      >
        <svg id="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <svg id="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4 hidden check-draw text-(--mono-accent)">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </button>
      <span
        id="copy-feedback"
        role="status"
        aria-live="polite"
        class="font-mono text-xs text-(--text-secondary) opacity-0 transition-opacity duration-200"
      ></span>
    </div>

    {(newerPost || olderPost) && (
      <nav
        aria-label="More posts"
        class="mt-12 pt-8 border-t border-(--border) flex flex-col gap-3 sm:flex-row sm:justify-between sm:gap-8"
      >
        {olderPost ? (
          <a
            href={`/blog/${olderPost.id}`}
            class="group flex-1 min-w-0"
          >
            <span class="font-mono text-xs text-(--text-secondary)">
              <span aria-hidden="true" class="icon-back">←</span> older
            </span>
            <span class="mt-1 block text-sm text-(--text-primary) group-hover:text-(--mono-accent) transition-colors">
              {olderPost.data.title}
            </span>
          </a>
        ) : (
          <span class="flex-1" aria-hidden="true" />
        )}
        {newerPost ? (
          <a
            href={`/blog/${newerPost.id}`}
            class="group flex-1 min-w-0 sm:text-right"
          >
            <span class="font-mono text-xs text-(--text-secondary)">
              newer <span aria-hidden="true" class="icon-fwd">→</span>
            </span>
            <span class="mt-1 block text-sm text-(--text-primary) group-hover:text-(--mono-accent) transition-colors">
              {newerPost.data.title}
            </span>
          </a>
        ) : (
          <span class="flex-1" aria-hidden="true" />
        )}
      </nav>
    )}

    <NewsletterInline />
  </article>

  <NewsletterModal /></Base>

<script>
  // Delegated so it keeps working after view-transition swaps.
  document.addEventListener("click", async (e) => {
    if (!(e.target instanceof Element) || !e.target.closest("#copy-url-btn")) return;

    const copyIcon = document.getElementById("copy-icon");
    const checkIcon = document.getElementById("check-icon");
    const feedback = document.getElementById("copy-feedback");

    let copied = false;
    try {
      await navigator.clipboard.writeText(window.location.href);
      copied = true;
    } catch {
      // Clipboard API unavailable (e.g. non-secure context) — fall back.
      const ta = document.createElement("textarea");
      ta.value = window.location.href;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      try {
        copied = document.execCommand("copy");
      } catch {
        copied = false;
      }
      ta.remove();
    }

    if (feedback) {
      feedback.textContent = copied ? "copied" : "couldn't copy — grab the url bar";
      feedback.classList.remove("opacity-0");
    }
    if (copied) {
      copyIcon?.classList.add("hidden");
      checkIcon?.classList.remove("hidden");
    }
    setTimeout(() => {
      copyIcon?.classList.remove("hidden");
      checkIcon?.classList.add("hidden");
      feedback?.classList.add("opacity-0");
    }, 2000);
  });
</script>

<script>
  // Reading progress bar, scoped to blog post pages.
  let ticking = false;
  const updateProgress = () => {
    ticking = false;
    const bar = document.getElementById("reading-progress");
    if (!bar) return;
    const denominator = document.body.scrollHeight - window.innerHeight;
    const progress = denominator > 0 ? Math.min(window.scrollY / denominator, 1) : 0;
    bar.style.transform = `scaleX(${progress})`;
  };
  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateProgress);
      }
    },
    { passive: true },
  );
  document.addEventListener("astro:page-load", updateProgress);
</script>

<script
  is:inline
  define:vars={{
    slug: post.id,
    title: post.data.title,
    category: post.data.category,
  }}
>
  window.posthog?.capture?.("blog_post_view", { slug, title, category });
  window.__POST__ = { slug, category };
</script>

<script>
  import { initNewsletter } from "@/scripts/newsletter";
  const init = () => {
    const post = (window as unknown as { __POST__?: { slug: string; category: string } }).__POST__;
    // __POST__ is set by the per-page inline script above; only wire up when
    // the current document is actually a blog post.
    if (post && document.querySelector("[data-newsletter]")) initNewsletter(post);
  };
  document.addEventListener("astro:page-load", init);
</script>

<style is:global>
  .prose-custom {
    color: var(--text-primary);
    font-size: 1rem;
    line-height: 1.75;
  }
  .prose-custom p {
    margin: 1.25em 0;
    color: var(--text-primary);
  }
  .prose-custom h1,
  .prose-custom h2,
  .prose-custom h3 {
    margin-top: 2em;
    margin-bottom: 0.5em;
    color: var(--text-primary);
    font-weight: 600;
    line-height: 1.3;
  }
  .prose-custom h2 { font-size: 1.25rem; }
  .prose-custom h3 { font-size: 1.05rem; }
  .prose-custom a {
    color: var(--mono-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .prose-custom strong { color: var(--text-primary); font-weight: 600; }
  .prose-custom ul,
  .prose-custom ol {
    margin: 1em 0;
    padding-left: 1.4em;
  }
  .prose-custom ul { list-style: disc; }
  .prose-custom ol { list-style: decimal; }
  .prose-custom li { margin: 0.4em 0; }
  .prose-custom code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--surface);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }
  .prose-custom pre {
    font-family: var(--font-mono);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem;
    overflow-x: auto;
    margin: 1.5em 0;
    font-size: 0.875em;
  }
  .prose-custom pre code {
    background: transparent;
    padding: 0;
    border-radius: 0;
  }
  .prose-custom blockquote {
    border-left: 2px solid var(--border);
    padding-left: 1em;
    color: var(--text-secondary);
    font-style: italic;
  }
  .prose-custom hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2em 0;
  }
  .prose-custom img {
    max-width: 100%;
    height: auto;
  }
</style>
