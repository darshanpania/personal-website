---
import Base from "@/layouts/Base.astro";
import { getCollection } from "astro:content";

interface Entry {
  id: string;
  title: string;
  date: Date;
  category: "tech" | "fiction" | "non-fiction";
  href: string;
  external: boolean;
}

const externals = await getCollection("blog");
const locals = await getCollection("posts", ({ data }) => !data.draft);

const entries: Entry[] = [
  ...externals.map((p) => ({
    id: p.id,
    title: p.data.title,
    date: p.data.date,
    category: p.data.category,
    href: p.data.url,
    external: true,
  })),
  ...locals.map((p) => ({
    id: p.id,
    title: p.data.title,
    date: p.data.date,
    category: p.data.category,
    href: `/blog/${p.id}`,
    external: false,
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const grouped: Record<string, Entry[]> = {};
for (const e of entries) {
  const year = e.date.getUTCFullYear().toString();
  (grouped[year] ??= []).push(e);
}
const years = Object.keys(grouped).sort((a, b) => Number(b) - Number(a));

const categories = ["all", "tech", "fiction", "non-fiction"] as const;
---

<Base title="writing — Darshan Pania" description="Essays on engineering leadership, mobile SDKs, and side projects.">
  <h1 class="font-mono text-xl md:text-[1.5625rem] font-medium text-(--text-primary)">
    writing
  </h1>

  <div
    id="category-pills"
    class="mt-6 flex flex-wrap gap-2 font-mono text-sm"
    data-active="all"
  >
    {
      categories.map((c) => (
        <button
          type="button"
          data-category={c}
          aria-pressed={c === "all" ? "true" : "false"}
          class="pill px-3 py-1 rounded-full border border-(--border) text-(--text-secondary) transition-[color,background-color,border-color,transform] duration-150 hover:text-(--text-primary) active:scale-95 motion-reduce:transform-none"
        >
          {c}
        </button>
      ))
    }
  </div>

  <p
    id="filter-empty"
    class="hidden mt-10 font-mono text-sm text-(--text-secondary)"
  >
    nothing here yet — still drafting<span class="cursor-blink"></span>
  </p>

  <div class="mt-10 space-y-10">
    {
      years.map((year) => (
        <section data-year={year}>
          <h2 class="font-mono text-sm text-(--text-secondary) mb-2">
            {year}
          </h2>
          <ul class="border-t border-(--border)">
            {
              grouped[year].map((e) => (
                <li
                  data-category={e.category}
                  class="post-row border-b border-(--border)"
                >
                  <a
                    href={e.href}
                    target={e.external ? "_blank" : undefined}
                    rel={e.external ? "noopener noreferrer" : undefined}
                    class="group flex items-baseline justify-between gap-4 py-3"
                  >
                    <span class="inline-block text-(--text-primary) group-hover:text-(--mono-accent) transition-[color,transform] duration-150 group-hover:translate-x-1 motion-reduce:transform-none">
                      {e.title}
                      {e.external && (
                        <span
                          aria-hidden="true"
                          class="ml-1 font-mono text-xs text-(--text-secondary) group-hover:text-(--mono-accent) transition-colors icon-ext"
                        >
                          ↗
                        </span>
                      )}
                    </span>
                    <span class="font-mono text-xs text-(--text-secondary) shrink-0">
                      {e.date.toLocaleString("en-US", { month: "short", timeZone: "UTC" })}{" "}
                      {e.date.getUTCFullYear()}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      ))
    }
  </div>

  <script>
    const init = () => {
      const container = document.getElementById("category-pills");
      if (!container) return; // not on this page
      const pills = container.querySelectorAll<HTMLButtonElement>(".pill");
      const rows = document.querySelectorAll<HTMLLIElement>(".post-row");
      const years = document.querySelectorAll<HTMLElement>("[data-year]");
      const empty = document.getElementById("filter-empty");

      const setActive = (cat: string, animate: boolean) => {
        pills.forEach((p) => {
          const active = p.dataset.category === cat;
          p.classList.toggle("bg-(--text-primary)", active);
          p.classList.toggle("text-(--bg)", active);
          p.classList.toggle("border-(--text-primary)", active);
          p.classList.toggle("text-(--text-secondary)", !active);
          p.setAttribute("aria-pressed", String(active));
        });

        let visibleIndex = 0;
        rows.forEach((r) => {
          const match = cat === "all" || r.dataset.category === cat;
          r.classList.toggle("hidden", !match);
          r.classList.remove("row-reveal");
          if (match && animate) {
            r.style.animationDelay = `${Math.min(visibleIndex * 30, 240)}ms`;
            r.classList.add("row-reveal");
            visibleIndex++;
          }
        });

        let anyVisible = false;
        years.forEach((sec) => {
          const visible = sec.querySelectorAll(".post-row:not(.hidden)").length > 0;
          sec.classList.toggle("hidden", !visible);
          anyVisible ||= visible;
        });

        empty?.classList.toggle("hidden", anyVisible);
        container.dataset.active = cat;
      };

      pills.forEach((p) =>
        p.addEventListener("click", () => setActive(p.dataset.category!, true)),
      );
      setActive("all", false);
    };
    document.addEventListener("astro:page-load", init);
  </script>
</Base>
