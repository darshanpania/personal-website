---
import Base from "@/layouts/Base.astro";
import { verifyConfirmToken } from "@/lib/confirm-token";

// The landing page for the link in the confirmation email. It only *checks*
// the token — nothing is subscribed until the reader presses the button,
// which POSTs to /api/confirm. Mail scanners and link prefetchers issue GETs,
// so confirming on GET would let a security appliance opt someone in on their
// behalf, which is precisely the consent this feature exists to obtain.
export const prerender = false;

const confirmSecret = import.meta.env.NEWSLETTER_CONFIRM_SECRET;
if (!confirmSecret) {
  console.error("[confirm] NEWSLETTER_CONFIRM_SECRET not set");
  return Astro.redirect("/subscribed?state=error", 302);
}

const token = Astro.url.searchParams.get("token");
const verified = verifyConfirmToken(token, confirmSecret);
if (!verified.ok) {
  return Astro.redirect(
    `/subscribed?state=${verified.error === "expired" ? "expired" : "invalid"}`,
    302,
  );
}
---

<Base
  title="confirm your subscription — Darshan Pania"
  description="Confirm your newsletter subscription."
>
  <section class="space-y-2">
    <h1
      class="font-mono text-2xl md:text-[2.25rem] font-medium text-(--text-primary) tracking-tight cursor-blink"
    >
      one last tap
    </h1>
    <p class="text-(--mono-accent) text-base font-mono">confirm your subscription</p>
  </section>

  <hr class="my-8 border-0 border-t border-(--border) w-10" />

  <p class="text-(--text-primary) text-base leading-7">
    Press the button and you're on the list — one email when a new post goes up,
    nothing in between. If you didn't sign up, close this tab and nothing
    happens.
  </p>

  <div class="mt-8">
    <button
      id="confirm-btn"
      type="button"
      data-token={token}
      class="rounded-md bg-(--mono-accent) px-4 py-2 font-mono text-sm font-medium text-(--bg) hover:opacity-90 disabled:opacity-50 disabled:cursor-not-allowed transition-[opacity,transform] duration-150 active:scale-[0.98] motion-reduce:transform-none"
    >
      confirm subscription
    </button>
    <p
      id="confirm-status"
      role="status"
      aria-live="polite"
      class="mt-3 min-h-[1.25rem] font-mono text-xs text-(--text-secondary)"
    >
    </p>
    <noscript>
      <p class="mt-3 font-mono text-xs text-(--text-secondary)">
        confirming needs javascript enabled. turn it on and reload, or reply to
        the email and I'll add you by hand.
      </p>
    </noscript>
  </div>
</Base>

<script>
  // Submitted as JSON rather than as a form. Astro's origin check refuses
  // form-encoded POSTs whose Origin doesn't match the origin it derives from
  // the request, and behind the Cloudflare -> Vercel proxy those never match,
  // so a plain <form> here 403s for every real visitor. JSON isn't a form-like
  // content type, so it passes — same path /api/subscribe already uses.
  // The states /subscribed knows how to render.
  const STATES = ["confirmed", "expired", "invalid", "error"];
  const btn = document.getElementById("confirm-btn") as HTMLButtonElement | null;
  const status = document.getElementById("confirm-status");
  const token = btn?.dataset.token ?? "";

  btn?.addEventListener("click", async () => {
    btn.disabled = true;
    if (status) status.textContent = "confirming…";

    try {
      const res = await fetch("/api/confirm", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ token }),
      });
      // Deliberately not swallowing a parse failure. A proxy hiccup that
      // returns an HTML error page instead of JSON is recoverable — the token
      // is good for 48 hours — so it belongs in the retry path below rather
      // than sending the reader to a dead-end error screen. Same for a state
      // we don't recognise: navigate only on a value the next page can render.
      const data = (await res.json()) as { state?: unknown };
      const state = String(data?.state);
      if (!STATES.includes(state)) throw new Error("unrecognised state");
      window.location.href = `/subscribed?state=${state}`;
    } catch {
      btn.disabled = false;
      if (status) {
        status.textContent = "that didn't go through — try again in a moment.";
      }
    }
  });
</script>
