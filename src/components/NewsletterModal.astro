---
// Scroll-triggered modal signup. Hidden by default; src/scripts/newsletter.ts
// shows it when the reader has scrolled past 50% of the article and has not
// dismissed/subscribed for this slug.
---

<div
  data-newsletter="modal"
  class="hidden fixed inset-0 z-50 items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="newsletter-modal-heading"
  aria-hidden="true"
>
  <div
    data-newsletter-backdrop
    class="absolute inset-0 bg-black/50"
  ></div>

  <div
    class="relative w-full max-w-sm rounded-lg border border-(--border) bg-(--bg) p-6 shadow-2xl"
  >
    <button
      data-newsletter-close
      type="button"
      aria-label="dismiss newsletter signup"
      class="absolute right-3 top-3 rounded-md p-1.5 text-(--text-secondary) hover:bg-(--surface) hover:text-(--text-primary) transition-colors"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div data-newsletter-form-wrap>
      <h2
        id="newsletter-modal-heading"
        class="text-lg font-medium text-(--text-primary)"
      >
        enjoying this?
      </h2>
      <p class="mt-2 text-sm text-(--text-secondary) leading-relaxed">
        let me send the next one to your inbox. ~1 per new post,
        unsubscribe anytime, pinky promise no spam.
      </p>

      <form
        data-newsletter-form
        class="mt-4 flex flex-col gap-2"
        novalidate
      >
        <label class="sr-only" for="newsletter-modal-firstname">first name (optional)</label>
        <input
          id="newsletter-modal-firstname"
          data-newsletter-firstname
          type="text"
          name="firstName"
          autocomplete="given-name"
          maxlength="100"
          placeholder="first name (optional)"
          class="rounded-md border border-(--border) bg-(--surface) px-3 py-2 font-mono text-sm text-(--text-primary) placeholder:text-(--text-secondary) focus:border-(--mono-accent) focus:outline-none"
        />
        <label class="sr-only" for="newsletter-modal-email">email</label>
        <input
          id="newsletter-modal-email"
          data-newsletter-email
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class="rounded-md border border-(--border) bg-(--surface) px-3 py-2 font-mono text-sm text-(--text-primary) placeholder:text-(--text-secondary) focus:border-(--mono-accent) focus:outline-none"
        />
        <input
          data-newsletter-website
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;"
        />
        <button
          data-newsletter-submit
          type="submit"
          class="rounded-md bg-(--mono-accent) px-4 py-2 font-mono text-sm font-medium text-(--bg) hover:opacity-90 disabled:opacity-50 disabled:cursor-not-allowed transition-opacity"
        >
          subscribe
        </button>
      </form>

      <p
        data-newsletter-status
        role="status"
        aria-live="polite"
        class="mt-2 min-h-[1.25rem] font-mono text-xs text-(--text-secondary)"
      ></p>

      <button
        data-newsletter-dismiss
        type="button"
        class="mt-3 w-full text-center font-mono text-xs text-(--text-secondary) hover:text-(--text-primary) transition-colors"
      >
        no thanks
      </button>
    </div>

    <div
      data-newsletter-success
      class="hidden text-sm text-(--text-primary)"
    >
      <p class="font-mono text-(--mono-accent)">✓ you're in.</p>
      <p class="mt-1 text-(--text-secondary)">
        check your inbox to confirm.
      </p>
    </div>
  </div>
</div>
