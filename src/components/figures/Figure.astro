---
// Chart and screenshot figure for long-form posts. On the email rendering
// (/newsletter/*) a figure that needs CSS or JS becomes a link to the site.
interface Props {
  title?: string;
  sub?: string;
  caption?: string;
  variant?: "bare" | "wide";
  emailSafe?: boolean;
}
const { title, sub, caption, variant, emailSafe = false } = Astro.props;
const isEmail = Astro.url.pathname.startsWith("/newsletter/");
const postUrl = Astro.url.pathname.replace(/^\/newsletter\//, "/blog/");
---

{isEmail && !emailSafe ? (
  <p>
    <a href={postUrl}>{title ? `${title}: view the chart on the site →` : "view this figure on the site →"}</a>
  </p>
) : (
  <figure class:list={["fig", variant]}>
    {title && <p class="ft" set:html={title} />}
    {sub && <p class="fs" set:html={sub} />}
    <slot />
    {caption && <figcaption set:html={caption} />}
  </figure>
)}

<style is:global>
  .fig {
    --s1: #2a78d6;
    --s2: #eb6834;
    --s3: #1baf7a;
    --mute: #b9b2a7;
    --bad: #c8402f;
    --good: #16794f;
    --navy: #0b1b3a;
    --navy-ink: #f4f6fb;
    --sun: #ffd233;
  }
  .dark .fig {
    --s1: #3987e5;
    --s2: #d95926;
    --s3: #199e70;
    --mute: #4a5058;
    --bad: #e66767;
    --good: #3fc08c;
  }
  .prose-custom figure.fig {
    margin: 1.8rem 0;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
  }
  .prose-custom figure.fig.bare { padding: 0; border: 0; background: none; }
  .prose-custom figure.fig.wide {
    margin-inline: calc(-1 * min(4rem, max(0px, (100vw - 640px - 2rem) / 2)));
  }
  .prose-custom .fig p { margin: 0; }
  .prose-custom .fig .ft { font-weight: 600; font-size: 0.98rem; line-height: 1.3; margin: 0 0 0.15rem; }
  .prose-custom .fig .fs { font-size: 0.84rem; color: var(--text-secondary); margin: 0 0 0.9rem; line-height: 1.4; }
  .fig figcaption { font-family: var(--font-mono); font-size: 0.74rem; color: var(--text-secondary); line-height: 1.5; margin-top: 0.8rem; }
  .fig img { display: block; width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--border); }
  .fig .pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0.8rem; }
  .fig .shots { display: grid; gap: 1.2rem; }
  .fig a.zoom { display: block; cursor: zoom-in; text-decoration: none; }
  .prose-custom .fig .shots .lab,
  .prose-custom .fig .pair .lab { font-family: var(--font-mono); font-size: 0.74rem; color: var(--text-secondary); margin: 0.35rem 0 0; }
  .fig .legend { display: flex; flex-wrap: wrap; gap: 0.2rem 1rem; font-size: 0.8rem; color: var(--text-secondary); margin: 0 0 0.7rem; }
  .fig .legend i { display: inline-block; width: 0.7em; height: 0.7em; border-radius: 2px; margin-right: 0.35em; }
  .fig .c1 { background: var(--s1); }
  .fig .c2 { background: var(--s2); }
  .fig .c3 { background: var(--s3); }
  .fig .cm { background: var(--mute); }
  .fig .scroll { overflow-x: auto; }
  .fig svg text { font-family: var(--font-mono); }
  /* horizontal bars */
  .fig .hb { display: grid; grid-template-columns: minmax(5.5rem, auto) 1fr auto; gap: 0.45rem 0.7rem; align-items: center; font-size: 0.86rem; }
  .fig .hb .l { line-height: 1.25; }
  .fig .hb .l small { display: block; color: var(--text-secondary); font-size: 0.76rem; }
  .fig .hb .t { height: 1.05rem; min-width: 0; }
  .fig .hb .b { height: 100%; border-radius: 0 4px 4px 0; min-width: 2px; transform-origin: left; }
  .fig .hb .v { font-family: var(--font-mono); font-size: 0.8rem; font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
  /* stats */
  .fig .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem 1rem; }
  @media (min-width: 560px) { .fig .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .fig .stats div b { display: block; font-weight: 600; font-size: 1.6rem; white-space: nowrap; line-height: 1.1; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .fig .stats div span { font-size: 0.8rem; color: var(--text-secondary); line-height: 1.35; display: block; }
  /* chat mock */
  .fig .chat { display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.9rem; line-height: 1.45; }
  .fig .chat .m { max-width: 85%; padding: 0.5rem 0.75rem; border-radius: 12px; background: var(--bg); border: 1px solid var(--border); }
  .fig .chat .u { align-self: flex-end; background: var(--mono-accent); color: var(--bg); border-color: transparent; }
  .fig .chat .m small { display: block; font-family: var(--font-mono); font-size: 0.68rem; opacity: 0.75; margin-bottom: 0.1rem; }
  .fig .chat .note { align-self: center; font-family: var(--font-mono); font-size: 0.72rem; color: var(--bad); }
  /* terminal */
  .fig .term { background: var(--navy); color: var(--navy-ink); border-radius: 10px; padding: 1rem 1.1rem; font-family: var(--font-mono); font-size: 0.8rem; line-height: 1.7; overflow-x: auto; }
  .fig .term .p { color: var(--sun); }
  .fig .term .d { opacity: 0.6; }
  .fig .term .cur { display: inline-block; width: 0.55em; height: 1em; background: var(--sun); vertical-align: -0.15em; animation: blink 1s steps(1) infinite; }
  /* scroll-in animation */
  .fig.play .hb .b { animation: fig-growx 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  @keyframes fig-growx { from { transform: scaleX(0); } }
  dialog.fig-lightbox { margin: auto; padding: 0; border: 0; background: transparent; max-width: 96vw; max-height: 96vh; }
  dialog.fig-lightbox::backdrop { background-color: rgba(0, 0, 0, 0.85); }
  dialog.fig-lightbox img { display: block; max-width: 96vw; max-height: 92vh; width: auto; height: auto; border-radius: 6px; cursor: zoom-out; }
  dialog.fig-lightbox p { margin: 0.4rem 0 0; text-align: center; font-family: var(--font-mono); font-size: 0.75rem; color: #e4e6e8; }
  #fig-tip { position: fixed; z-index: 50; pointer-events: none; background: var(--text-primary); color: var(--bg); font-family: var(--font-mono); font-size: 0.72rem; line-height: 1.4; padding: 0.3rem 0.5rem; border-radius: 5px; max-width: 16rem; white-space: pre-line; }
  @media (prefers-reduced-motion: reduce) {
    .fig *, .fig.play * { animation: none !important; }
  }
</style>

<script>
  // Bars grow when a figure scrolls into view; [data-tip] shows a tooltip.
  let io: IntersectionObserver | null = null;
  const init = () => {
    io?.disconnect();
    if ("IntersectionObserver" in window) {
      io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("play");
              io?.unobserve(e.target);
            }
          }
        },
        { threshold: 0.25 },
      );
      document.querySelectorAll("figure.fig").forEach((f) => io?.observe(f));
    }
  };
  document.addEventListener("astro:page-load", init);

  // Screenshots open full size in a lightbox; the link is the no-JS fallback.
  document.addEventListener("click", (e) => {
    const link = (e.target as Element | null)?.closest?.(".fig a.zoom");
    if (!(link instanceof HTMLAnchorElement)) return;
    if (e.metaKey || e.ctrlKey || e.shiftKey || typeof HTMLDialogElement !== "function") return;
    e.preventDefault();
    const dlg = document.createElement("dialog");
    dlg.className = "fig-lightbox";
    const img = document.createElement("img");
    img.src = link.href;
    img.alt = link.querySelector("img")?.alt ?? "";
    const hint = document.createElement("p");
    hint.textContent = "tap or press Esc to close";
    dlg.append(img, hint);
    dlg.addEventListener("click", () => dlg.close());
    dlg.addEventListener("close", () => dlg.remove());
    document.body.appendChild(dlg);
    dlg.showModal();
  });

  let tip: HTMLElement | null = null;
  document.addEventListener("pointermove", (e) => {
    const t = (e.target as Element | null)?.closest?.("[data-tip]");
    if (!t) {
      if (tip) tip.hidden = true;
      return;
    }
    if (!tip || !tip.isConnected) {
      tip = document.createElement("div");
      tip.id = "fig-tip";
      tip.setAttribute("aria-hidden", "true");
      document.body.appendChild(tip);
    }
    tip.textContent = t.getAttribute("data-tip");
    tip.hidden = false;
    const x = Math.min(e.clientX + 12, window.innerWidth - tip.offsetWidth - 8);
    let y = e.clientY + 14;
    if (y + tip.offsetHeight > window.innerHeight) y = e.clientY - tip.offsetHeight - 8;
    tip.style.left = `${x}px`;
    tip.style.top = `${y}px`;
  });
</script>
