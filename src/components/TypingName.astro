---
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<h1
  id="typing-name"
  class="font-mono text-2xl md:text-[2.25rem] font-medium text-(--text-primary) tracking-tight cursor-blink"
  data-text={text}
>
  <span id="typing-target"></span>
</h1>

<script>
  const el = document.getElementById("typing-target");
  const host = document.getElementById("typing-name");
  const text = host?.dataset.text ?? "";
  if (el && text) {
    let i = 0;
    const step = Math.max(40, Math.floor(800 / text.length));
    const tick = () => {
      el.textContent = text.slice(0, ++i);
      if (i < text.length) setTimeout(tick, step);
    };
    setTimeout(tick, 150);
  }
</script>
