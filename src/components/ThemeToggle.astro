---
<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle theme"
  aria-pressed="false"
  class="text-text-secondary hover:text-text-primary transition-colors text-sm p-2 -m-2"
>
  <span class="relative inline-block w-4 h-4 align-middle">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-4 h-4 sun-icon absolute inset-0">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-linecap="round" />
    </svg>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 moon-icon absolute inset-0">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>
  </span>
</button>

<style>
  .sun-icon,
  .moon-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .sun-icon,
    .moon-icon {
      transition:
        opacity 200ms ease-out,
        transform 300ms ease-out;
    }
  }
  :global(.dark) .sun-icon {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }
  :global(html:not(.dark)) .moon-icon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
</style>

<script>
  // Delegated handler registered once on the persistent document, so the
  // toggle keeps working after view transitions swap the button element.
  const syncPressed = () => {
    document
      .getElementById("theme-toggle")
      ?.setAttribute(
        "aria-pressed",
        String(document.documentElement.classList.contains("dark")),
      );
  };

  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Element) || !e.target.closest("#theme-toggle")) return;
    const root = document.documentElement;
    const next = root.classList.contains("dark") ? "light" : "dark";

    // Animate the color swap, but never on regular page loads.
    root.classList.add("theme-transition");
    window.setTimeout(() => root.classList.remove("theme-transition"), 300);

    root.classList.toggle("dark", next === "dark");
    try {
      localStorage.setItem("theme", next);
    } catch {
      /* storage blocked — apply for the session anyway */
    }
    syncPressed();
  });

  document.addEventListener("astro:page-load", syncPressed);
</script>
