---
const year = new Date().getFullYear();
---

<footer class="no-print border-t border-(--border)">
  <div
    class="mx-auto max-w-[640px] px-4 py-6 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 font-mono text-xs text-(--text-secondary)"
  >
    <span>© {year} darshan pania</span>
    <span class="flex items-center gap-4">
      {/* Shown by src/world/boot.ts when the browser can draw the 3D world. */}
      <button
        id="world-toggle"
        type="button"
        aria-pressed="false"
        hidden
        class="cursor-pointer py-2 -my-2 hover:text-(--mono-accent) transition-colors"
      >
        3d: <span data-world-state>off</span>
      </button>
      <a
        href="/rss.xml"
        class="hover:text-(--mono-accent) transition-colors"
      >
        rss
      </a>
      <a
        href="https://github.com/darshanpania/personal-website"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-(--mono-accent) transition-colors"
      >
        source <span aria-hidden="true" class="icon-ext">↗</span>
      </a>
    </span>
  </div>
</footer>
